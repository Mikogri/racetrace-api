@racetrace-api_HostAddress = http://127.0.0.1:5127
@ApiReadSecret = replace-with-api-read-secret
@AdminApiSecret = replace-with-admin-api-secret

GET {{racetrace-api_HostAddress}}/api/v1/rounds?limit=1
Authorization: Bearer {{ApiReadSecret}}
Accept: application/json

###

GET {{racetrace-api_HostAddress}}/api/v1/riders/183/overview?season=2025
Authorization: Bearer {{ApiReadSecret}}
Accept: application/json

###

GET {{racetrace-api_HostAddress}}/api/admin/editable-resources
Authorization: Bearer {{AdminApiSecret}}
Accept: application/json

###

PATCH {{racetrace-api_HostAddress}}/api/admin/tracks/1
Authorization: Bearer {{AdminApiSecret}}
Content-Type: application/json

{
  "name": "Les Gets World Cup Track",
  "venue": "Les Gets",
  "countryCode": "FRA",
  "lengthM": 2380,
  "avgSlope": 21.0
}

###

PATCH {{racetrace-api_HostAddress}}/api/admin/rounds/1
Authorization: Bearer {{AdminApiSecret}}
Content-Type: application/json

{
  "conditionId": 2,
  "startDate": "2024-07-05T00:00:00Z",
  "endDate": "2024-07-07T23:59:59Z"
}

###

PATCH {{racetrace-api_HostAddress}}/api/admin/sessions/25
Authorization: Bearer {{AdminApiSecret}}
Content-Type: application/json

{
  "name": "Semi-Final",
  "sessionDate": "2024-07-06",
  "conditionId": 2,
  "status": "finished"
}

###

PATCH {{racetrace-api_HostAddress}}/api/admin/riders/7
Authorization: Bearer {{AdminApiSecret}}
Content-Type: application/json

{
  "profileImageUrl": "https://images.example.com/riders/7.jpg"
}

###

PATCH {{racetrace-api_HostAddress}}/api/admin/riders/7
Authorization: Bearer {{AdminApiSecret}}
Content-Type: application/json

{
  "hasInjury": true
}

###

POST {{racetrace-api_HostAddress}}/api/admin/sessions/25/reimport
Authorization: Bearer {{AdminApiSecret}}
Content-Type: application/json

{
  "chronoraceUrl": "https://prod.chronorace.be/angular/results.html#/uci/event/20240704_mtb/DHI/CG1/dh/91/res"
}

###

# Paste the complete UCI MTB World Series response as the request body.
POST {{racetrace-api_HostAddress}}/api/admin/sessions/25/supplement/uci-mtb-world-series
Authorization: Bearer {{AdminApiSecret}}
Content-Type: application/json

{
  "error": false,
  "results": []
}

###
